# Example environment variables for local docker-compose usage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=breathesg
DATABASE_HOST=db
DATABASE_PORT=5432
# Example DATABASE_URL for Django: postgres://user:pass@host:port/dbname
# DATABASE_URL=postgres://postgres:postgres@db:5432/breathesg

# Django
SECRET_KEY=replace-this-with-a-secure-key
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
